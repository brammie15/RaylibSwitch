if(NOT NXLINK OR NOT EXISTS "${NXLINK}")
    message(FATAL_ERROR "nxlink not found (install switch-tools)")
endif()
if(NOT EXISTS "${NRO}")
    message(FATAL_ERROR "NRO not found: ${NRO}")
endif()

set(args "")
if(NXLINK_IP)
    list(APPEND args -a "${NXLINK_IP}")
endif()
if(NXLINK_RETRIES)
    list(APPEND args -r "${NXLINK_RETRIES}")
endif()
if(NXLINK_SERVER)
    list(APPEND args -s)
endif()

message(STATUS "nxlink: sending ${NRO} ${args}")
execute_process(COMMAND "${NXLINK}" ${args} "${NRO}" RESULT_VARIABLE rc)

if(NOT rc EQUAL 0)
    set(msg "nxlink failed (exit ${rc}). Is the Switch on the same network with hbmenu open in nxlink mode (press Y)?")
    if(NXLINK_REQUIRED)
        message(FATAL_ERROR "${msg}")
    else()
        message(WARNING "${msg}")
    endif()
endif()
